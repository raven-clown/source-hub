DATABASE_URL=postgresql://user:password@host:5432/postgres

# anthropic (default) or openai_compatible
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5

# only used when LLM_PROVIDER=openai_compatible — points at any OpenAI-compatible
# chat-completions endpoint: Ollama, vLLM, LM Studio, OpenRouter, Together, Groq, etc.
# example for local Ollama running Qwen:
#   OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#   OPENAI_COMPATIBLE_MODEL=qwen2.5:14b
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

NOTION_API_KEY=

LINEAR_API_KEY=

GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=
GCAL_CALENDAR_ID=primary

API_PORT=3000
API_KEY=
API_CORS_ORIGIN=*
