{
  "name": "source-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "tsx scripts/migrate.ts",
    "sync": "tsx src/cli.ts sync",
    "mcp": "tsx src/cli.ts mcp",
    "mcp:debug": "mcp-debug run -- npx tsx src/cli.ts mcp",
    "api": "tsx src/cli.ts api",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "scan:sast": "eslint .",
    "scan:secrets": "secretlint \"**/*\"",
    "scan:deps": "npm audit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/cors": "^11.3.0",
    "@linear/sdk": "^95.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@notionhq/client": "^5.26.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.4",
    "googleapis": "^180.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^10.10.0",
    "eslint-plugin-security": "^4.0.1",
    "mcp-stdio-debug": "^1.9.0",
    "secretlint": "^13.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
